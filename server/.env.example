########################################################################
# VERITEK IoT backend - environment
#
# Copy to `.env` and edit. Every value here has a working default, so the
# stack boots with an empty file; the settings that MUST change before the
# real gateway goes live are marked [PRODUCTION].
#
# Nothing about the gateway's topic tree, JSON schema, credentials or
# Modbus register layout is compiled into the source. It is all here, or in
# the database (payload profiles and register maps).
########################################################################

# ---------------------------------------------------------------- runtime --
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info                 # trace | debug | info | warn | error
LOG_PRETTY=true                # false emits JSON lines for a log collector
PUBLIC_BASE_URL=http://localhost:4000
# Origins allowed to call the API from a browser (the React dashboard).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------- database --
# auto = Postgres when DATABASE_URL is set, otherwise the embedded SQLite file.
DB_DRIVER=auto
# [PRODUCTION] Point at PostgreSQL, ideally with the TimescaleDB extension.
# DATABASE_URL=postgres://veritek:secret@localhost:5432/veritek_iot
DATABASE_SSL=false
DATABASE_POOL_MAX=10
SQLITE_PATH=./data/veritek-iot.db
TIMESCALE_ENABLED=true         # creates hypertables when the extension exists
DB_AUTO_MIGRATE=true

# ------------------------------------------------------------------- MQTT --
# PREFERRED INTEGRATION. Everything below is a placeholder until the gateway
# is on the bench - see "Still unknown" at the bottom of this file.
MQTT_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# mqtt | mqtts | ws | wss. Leave blank to follow MQTT_TLS.
MQTT_PROTOCOL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=veritek-backend

# Topic the gateway publishes telemetry on. UNKNOWN until commissioning.
MQTT_TELEMETRY_TOPIC=veritek/+/telemetry
# Topic templates for remote configuration. {gatewayUid} is substituted.
MQTT_COMMAND_TOPIC=veritek/{gatewayUid}/command
MQTT_STATUS_TOPIC=veritek/{gatewayUid}/status

# [PRODUCTION] Turn TLS on once the unit's TLS support is confirmed.
MQTT_TLS=false
MQTT_TLS_CA_PATH=
MQTT_TLS_CERT_PATH=
MQTT_TLS_KEY_PATH=
MQTT_TLS_REJECT_UNAUTHORIZED=true

MQTT_QOS=1
MQTT_RETAIN=false
MQTT_PROTOCOL_VERSION=4        # 4 = MQTT 3.1.1, 5 = MQTT 5.0 (unit's support unconfirmed)
MQTT_CLEAN_SESSION=true
MQTT_KEEPALIVE_SECONDS=60
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_CONNECT_TIMEOUT_MS=30000

# COMMISSIONING: subscribe broadly so the first packet is captured whatever
# topic the gateway picks. NARROW THIS to the device-specific topic once the
# real topic is known, e.g. veritek/GW-ABC-0001/telemetry
MQTT_SUBSCRIBE_TOPICS=veritek/#

# Last will: the broker announces our absence if this process dies.
MQTT_LWT_TOPIC=
MQTT_LWT_PAYLOAD={"status":"offline"}
MQTT_LWT_QOS=1
MQTT_LWT_RETAIN=true

# ------------------------------------------------- embedded dev broker --
# Lets the whole path run with no Mosquitto/EMQX installed. [PRODUCTION] off.
EMBEDDED_BROKER_ENABLED=true
EMBEDDED_BROKER_PORT=1883
EMBEDDED_BROKER_ALLOW_ANONYMOUS=false     # section 18: no anonymous topic tree
EMBEDDED_BROKER_DEFAULT_USERNAME=veritek-gateway
# Leave blank and one is generated per run and printed once to the log.
EMBEDDED_BROKER_DEFAULT_PASSWORD=

# ----------------------------------------------------------------- ingest --
INGEST_MAX_PAYLOAD_BYTES=262144
INGEST_RATE_LIMIT_PER_MINUTE=600
INGEST_QUEUE_MAX=10000
INGEST_WORKERS=2
RAW_RETENTION_DAYS=30          # 0 keeps raw packets forever
# [PRODUCTION] Require a device token on the HTTP ingest endpoint.
INGEST_REQUIRE_AUTH=false
# Commissioning convenience: create records for devices we have never seen.
# [PRODUCTION] Turn both off once the estate is known.
AUTO_PROVISION_GATEWAYS=true
AUTO_PROVISION_METERS=true

# ------------------------------------------------------------------- time --
DEFAULT_SITE_TIMEZONE=Asia/Kolkata
# Applied when a device timestamp carries no offset. The unit has an RTC;
# whether it stamps UTC or local time is unconfirmed.
DEFAULT_SOURCE_UTC_OFFSET=+05:30
# Lag beyond which a reading is treated as replayed from the gateway buffer.
BUFFERED_THRESHOLD_SECONDS=120
MAX_PAST_SKEW_SECONDS=2592000  # 30 days; older claims fall back to server time
MAX_FUTURE_SKEW_SECONDS=300

# ----------------------------------------------------------------- health --
# Never hard-coded to five minutes; match these to the real poll interval.
GATEWAY_STALE_AFTER_SECONDS=300
GATEWAY_OFFLINE_AFTER_SECONDS=900
METER_STALE_AFTER_SECONDS=900
HEALTH_SCAN_INTERVAL_SECONDS=30

# ------------------------------------------------------------ aggregation --
AGGREGATION_ENABLED=true
AGGREGATION_INTERVAL_SECONDS=20
AGGREGATION_BATCH=500

# ----------------------------------------------------------------- energy --
ENERGY_MAX_DELTA_PER_HOUR=100000
ENERGY_COUNTER_ROLLOVER_VALUES=999999.9,999999,4294967295,99999999
ENERGY_BACKWARD_TOLERANCE=0.001

# ----------------------------------------------------------------- alerts --
ALERTS_ENABLED=true

# --------------------------------------------------------------- commands --
# Remote configuration stays disarmed until the vendor's exact command syntax is
# known AND a verified command_templates row exists. Both gates must pass.
COMMANDS_ENABLED=false
COMMAND_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------- auth --
AUTH_ENABLED=true
# [PRODUCTION] Replace both. Rotating JWT_SECRET invalidates every session;
# rotating TOKEN_PEPPER invalidates every device token.
JWT_SECRET=dev-only-change-me
TOKEN_PEPPER=dev-only-change-me
JWT_TTL_SECONDS=43200
API_RATE_LIMIT_PER_MINUTE=600
SEED_ADMIN_EMAIL=admin@veritek.com
SEED_ADMIN_PASSWORD=Pass@123   # [PRODUCTION] change before first boot

# -------------------------------------------------------------- simulator --
# Synthetic meter data for testing. [PRODUCTION] must be false.
SIMULATOR_ENABLED=false
SIMULATOR_GATEWAY_UID=TEST-GW-001
SIMULATOR_SLAVE_IDS=1,2
SIMULATOR_INTERVAL_SECONDS=15
SIMULATOR_JITTER_SECONDS=5
SIMULATOR_TOPIC=veritek/{gatewayUid}/telemetry
SIMULATOR_TRANSPORT=mqtt       # mqtt | http
SIMULATOR_DEVICE_TOKEN=

######################################################################
# PRODUCTION BROKER (EMQX)
#
# Local development uses the embedded broker above. These take over when
# the stack runs against EMQX - see deploy/README.md.
######################################################################

# Public DNS name devices are configured against. Never a raw IP: the
# infrastructure has to be replaceable without reconfiguring the fleet.
MQTT_PUBLIC_HOST=mqtt.energy.example.com
MQTT_PUBLIC_TLS_PORT=8883
MQTT_PUBLIC_PLAIN_PORT=1883
# Plaintext 1883. Commissioning window only; false in steady state.
MQTT_PLAINTEXT_ENABLED=true

# Our topic convention: energy/v1/gateways/{gatewayId}/{telemetry|status|command|response}
MQTT_TOPIC_ROOT=energy/v1
# Extra namespaces for a gateway that cannot publish on our topics.
# Filled in at commissioning only if the hardware requires it.
MQTT_VENDOR_TOPICS=

# Shared secret EMQX presents on the auth/ACL webhooks. [PRODUCTION] change it.
BROKER_WEBHOOK_SECRET=dev-only-change-me
BROKER_WEBHOOK_ENABLED=true
BROKER_WEBHOOK_RATE_LIMIT_PER_MINUTE=3000

# Reconnection: exponential backoff with jitter, so a broker restart does not
# bring the whole fleet back in the same millisecond.
MQTT_RECONNECT_MIN_MS=1000
MQTT_RECONNECT_MAX_MS=60000
MQTT_RECONNECT_JITTER_RATIO=0.3

# --------------------------------------------------------- observability --
METRICS_ENABLED=true
METRICS_PATH=/metrics
# Bearer token for /metrics. Blank leaves it open on the internal network.
METRICS_TOKEN=
METRICS_REFRESH_SECONDS=15
# Certificate file to watch for expiry. Blank probes the live listener instead.
TLS_CERT_PATH_FOR_EXPIRY_CHECK=
TLS_EXPIRY_WARNING_DAYS=21
MQTT_AUTH_EVENT_RETENTION_DAYS=30

# staging | production. Keeps the two estates apart.
DEPLOY_ENVIRONMENT=development

########################################################################
# STILL UNKNOWN UNTIL THE GATEWAY IS CONNECTED
#
#   1. the meter's Modbus register table (addresses, datatypes, byte/word
#      order, scaling)          -> Admin > meter models > registers
#   2. one real JSON packet from the gateway
#                               -> becomes the veritek_schema_v1 profile
#   3. the production MQTT topic and the remote-command syntax
#                               -> MQTT_SUBSCRIBE_TOPICS + command templates
#   4. the unit's MQTT auth / TLS capabilities
#                               -> MQTT_TLS and per-gateway credentials
#
# Also unconfirmed and therefore left unset rather than guessed: meter slave
# id, baud rate, parity, stop bits and poll interval (per meter, in the
# database), and the gateway's own id representation (IMEI vs serial).
########################################################################
