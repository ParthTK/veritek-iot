# Production deployment environment.
#
#   cp deploy/env/production.env.example deploy/env/production.env
#   # fill in every value marked REQUIRED, then:
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/env/production.env up -d
#
# deploy/env/*.env is gitignored. Never commit a filled-in copy. In a managed
# environment, inject these from the secret manager instead of a file.
#
# Generate every secret below with:  openssl rand -base64 32

DEPLOY_ENVIRONMENT=production

# ---------------------------------------------------------------- identity --
# REQUIRED. The permanent DNS name the gateways are configured against
# (spec section 2). A DNS name, never a raw IP - infrastructure has to be
# replaceable without reconfiguring deployed hardware.
MQTT_PUBLIC_HOST=mqtt.energy.example.com
# Used for the ACME certificate and the dashboard.
API_PUBLIC_HOST=api.energy.example.com
CORS_ORIGINS=https://dashboard.energy.example.com
GRAFANA_ROOT_URL=https://grafana.energy.example.com

# ---------------------------------------------------------------- database --
POSTGRES_USER=veritek
POSTGRES_DB=veritek_iot
# REQUIRED
POSTGRES_PASSWORD=

# ------------------------------------------------------------------ broker --
# Mosquitto image tag. Pinned: a broker upgrade is a deliberate change.
MOSQUITTO_VERSION=2.1.2-alpine
# Kept for the EMQX webhook mode only; Mosquitto does not use it. Still set it:
# the backend warns while it is the development default.
BROKER_WEBHOOK_SECRET=

# The backend's own MQTT identity. Never a gateway's credential (section 9).
MQTT_SERVICE_USERNAME=energy-backend-ingestion
# REQUIRED
MQTT_SERVICE_PASSWORD=

# The broker-admin identity the backend uses to create, suspend and revoke
# device logins through Mosquitto's Dynamic Security plugin. It can issue
# credentials, so guard it like the database password. Set once: it is written
# into the broker's credential store when that store is first created.
MQTT_CONTROL_USERNAME=veritek-control
# REQUIRED
MQTT_CONTROL_PASSWORD=

# Our topic convention. Leave as-is unless the estate needs a second version.
MQTT_TOPIC_ROOT=energy/v1
# Extra namespaces for a gateway that cannot publish on our topics. Fill in at
# commissioning only if the gateway turns out to require it.
MQTT_VENDOR_TOPICS=

# Plaintext 1883. Keep false in steady state; open it only for a controlled
# commissioning window, and close it again afterwards (section 3).
MQTT_PLAINTEXT_ENABLED=false
# Bind address for 1883. 127.0.0.1 keeps it off the internet entirely;
# 0.0.0.0 publishes it - only with the firewall opened deliberately.
MQTT_PLAIN_BIND=127.0.0.1

# ----------------------------------------------------------- app security --
# REQUIRED. Rotating JWT_SECRET signs out every user; rotating TOKEN_PEPPER
# invalidates every HTTP device token.
JWT_SECRET=
TOKEN_PEPPER=
# REQUIRED. First administrator. Change the password after the first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Bearer token for /metrics. Blank leaves it open on the internal network only.
METRICS_TOKEN=

# Off in production: devices are provisioned deliberately, not by showing up.
AUTO_PROVISION_GATEWAYS=false
AUTO_PROVISION_METERS=false

# ------------------------------------------------------------- monitoring --
# REQUIRED
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------- backups --
BACKUP_RETENTION_DAYS=30
# Strongly recommended. A backup on the same disk as the database survives
# neither a disk failure nor a deleted VM (section 22).
BACKUP_S3_TARGET=

# ------------------------------------------------------------------- certs --
# Used by deploy/scripts/issue-certificate.sh.
ACME_EMAIL=ops@example.com
