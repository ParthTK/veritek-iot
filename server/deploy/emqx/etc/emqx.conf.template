# EMQX 5.8 configuration for the VERITEK energy platform.
#
# Rendered to emqx.conf by deploy/scripts/render-emqx-config.sh, which fills
# the __PLACEHOLDER__ tokens from the deployment env file. The rendered file is
# gitignored because it contains the webhook secret.
#
# The ${username} / ${topic} forms below are EMQX's own placeholders and must
# survive rendering verbatim - which is why the render script substitutes
# __TOKENS__ with sed rather than running envsubst over the file.

node {
  data_dir = "data"
}

log {
  console {
    enable = true
    level = warning
    formatter = json
  }
}

# ---------------------------------------------------------------- listeners --

listeners.tcp.default {
  # Plaintext. Published only when MQTT_PLAIN_BIND=0.0.0.0 for a commissioning
  # window - the gateway's TLS capability is not yet confirmed (spec section 3).
  bind = "0.0.0.0:1883"
  max_connections = 5000
  # Generous: a site returning from a 4G outage uploads its whole buffer at
  # once, and throttling that loses real meter data (spec section 15).
  max_conn_rate = "200/s"
  messages_rate = "2000/s"
  bytes_rate = "20MB/s"
}

listeners.ssl.default {
  # The production endpoint: mqtts://__MQTT_PUBLIC_HOST__:8883
  bind = "0.0.0.0:8883"
  max_connections = 20000
  max_conn_rate = "200/s"
  messages_rate = "2000/s"
  bytes_rate = "20MB/s"
  ssl_options {
    cacertfile = "etc/certs/chain.pem"
    certfile = "etc/certs/fullchain.pem"
    keyfile  = "etc/certs/privkey.pem"
    # Devices authenticate with username/password over TLS. Mutual TLS is not
    # assumed because the gateway's client-certificate support is unverified.
    verify = verify_none
    fail_if_no_peer_cert = false
    versions = ["tlsv1.3", "tlsv1.2"]
  }
}

# Unused listeners are only attack surface.
listeners.ws.default  { enable = false }
listeners.wss.default { enable = false }

# ------------------------------------------------------------------- limits --

mqtt {
  max_packet_size = 1MB
  max_topic_levels = 12
  max_qos_allowed = 1
  # Tolerate a cellular link that misses a keepalive before dropping it.
  keepalive_multiplier = 1.5
  retain_available = true
  max_clientid_len = 128
}

force_shutdown {
  enable = true
  max_mailbox_size = 10000
  max_heap_size = 64MB
}

# ----------------------------------------------------------- authentication --
# Every CONNECT is resolved against the backend's credential table. No static
# password file to edit per install; a revoked credential stops working on the
# next connection attempt (spec sections 5, 6 and 33).

authentication = [
  {
    mechanism = password_based
    backend = http
    enable = true
    method = post
    url = "__BACKEND_INTERNAL_URL__/internal/broker/auth"
    headers {
      "content-type" = "application/json"
      "x-broker-secret" = "__BROKER_WEBHOOK_SECRET__"
    }
    body {
      username = "${username}"
      password = "${password}"
      clientid = "${clientid}"
      peerhost = "${peerhost}"
    }
    request_timeout = "5s"
    pool_size = 16
  }
]

# ------------------------------------------------------------ authorization --

authorization {
  # Anything not explicitly permitted is denied, and a client that tries is
  # disconnected rather than silently ignored (spec section 8).
  no_match = deny
  deny_action = disconnect

  # A minute: keeps chatty devices off the backend, and bounds how long a
  # revocation takes to bite on an already-connected client.
  cache {
    enable = true
    max_size = 8192
    ttl = "1m"
  }

  sources = [
    {
      type = file
      enable = true
      path = "etc/acl.conf"
    },
    {
      type = http
      enable = true
      method = post
      url = "__BACKEND_INTERNAL_URL__/internal/broker/acl"
      headers {
        "content-type" = "application/json"
        "x-broker-secret" = "__BROKER_WEBHOOK_SECRET__"
      }
      body {
        username = "${username}"
        clientid = "${clientid}"
        topic = "${topic}"
        action = "${action}"
        peerhost = "${peerhost}"
      }
      request_timeout = "5s"
      pool_size = 16
    }
  ]
}

# --------------------------------------------------------------- dashboard --
# Published on loopback only by the compose port mapping.

dashboard {
  listeners.http {
    bind = "0.0.0.0:18083"
  }
}
