node_modules
dist
data
.env
.env.local
*.log

# Deployment secrets. Templates are committed; filled-in copies never are.
deploy/env/*.env
!deploy/env/*.env.example
# TLS private keys and certificates.
deploy/certs/*
!deploy/certs/.gitkeep
deploy/mosquitto/passwd
deploy/mosquitto/aclfile
deploy/mosquitto/certs/*
!deploy/mosquitto/certs/.gitkeep

# Generated on the host at deploy time.
deploy/letsencrypt/
deploy/certbot-webroot/*
!deploy/certbot-webroot/.gitkeep
deploy/dashboard/*
!deploy/dashboard/.gitkeep
